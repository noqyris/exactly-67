# Splash master (4.3 MB, 2192x3824, with audio). The shipped derivative is
# public/splash.mp4 — 1200px wide, audio stripped, ~0.5 MB — which IS committed.
# Regenerate it with:
#   ffmpeg -i splashscreen-9-16.mp4 -an -vf scale=1200:-2 -c:v libx264 \
#     -profile:v main -pix_fmt yuv420p -crf 24 -preset slow \
#     -movflags +faststart public/splash.mp4
splashscreen-9-16.mp4
