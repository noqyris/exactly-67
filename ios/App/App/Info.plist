    <!-- Version and build number come from the build settings (project.pbxproj:
         MARKETING_VERSION / CURRENT_PROJECT_VERSION, App target, both configs),
         never literals here. The two-build release bumps the build number twice
         in a row; a literal copy in this file is one more place to forget, and
         the post-sync `git checkout` of this file silently undoes an uncommitted
         bump, so the ads-off N+1 archive would still say N and bounce as a
         duplicate while the real-ads N sits newest on TestFlight. -->
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
