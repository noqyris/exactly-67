default_platform(:ios)

# App Store Connect API key. Preferred: keys/asc_api_key.json (fastlane API-key
# JSON: key_id, issuer_id, key, duration, in_house) — gitignored, never commit.
# Fallback: env vars ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_PATH (path to the .p8).
def asc_api_key
  require "json"
  json = File.join(__dir__, "keys", "asc_api_key.json")
  # set_spaceship_token so the older produce/tunes actions authenticate too.
  if File.exist?(json)
    data = JSON.parse(File.read(json))
    return app_store_connect_api_key(
      key_id: data["key_id"],
      issuer_id: data["issuer_id"],
      key_content: data["key"],
      in_house: data.fetch("in_house", false),
      set_spaceship_token: true,
    )
  end
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: ENV.fetch("ASC_KEY_PATH"),
    in_house: false,
    set_spaceship_token: true,
  )
end

APP_NAME = "Exactly 67: Number Puzzle"

# Register the bundle id (Developer Portal) and create the App Store Connect
# record directly via Spaceship ConnectAPI — produce needs an Apple ID login,
# but the API-key token drives ConnectAPI fine.
def ensure_app_exists(_key)
  require "spaceship"

  existing = (Spaceship::ConnectAPI::BundleId.all.find { |b| b.identifier == APP_ID } rescue nil)
  if existing.nil?
    Spaceship::ConnectAPI::BundleId.create(name: "Exactly 67", identifier: APP_ID, platform: "IOS")
    UI.success("Registered bundle id #{APP_ID}")
  else
    UI.message("Bundle id #{APP_ID} already registered.")
  end

  app = (Spaceship::ConnectAPI::App.find(APP_ID) rescue nil)
  if app.nil?
    Spaceship::ConnectAPI::App.create(
      name: APP_NAME,
      version_string: "1.0.0",
      sku: "exactly67",
      primary_locale: "en-US",
      bundle_id: APP_ID,
      platforms: ["IOS"],
    )
    UI.success("Created App Store Connect record: #{APP_NAME}")
  else
    UI.message("App record already exists (#{app.name}).")
  end
end

TEAM = "YMN45WC2QR"
APP_ID = "com.noqyris.exactly67"

def build_ipa
  update_code_signing_settings(
    use_automatic_signing: true,
    team_id: TEAM,
    path: "App.xcodeproj",
    targets: ["App"],
  )
  build_app(
    project: "App.xcodeproj",
    scheme: "App",
    configuration: "Release",
    export_method: "app-store",
    output_directory: "./build",
    output_name: "Exactly67.ipa",
    xcargs: "-allowProvisioningUpdates",
    clean: true,
  )
end

platform :ios do
  desc "Verify auth + create the App Store Connect app record only"
  lane :create_app do
    ensure_app_exists(asc_api_key)
  end

  desc "Build + sign the store IPA only (no app record / upload needed)"
  lane :build_only do
    asc_api_key
    build_ipa
  end

  desc "Full pipeline: create app record, build+sign, upload build, push metadata+screenshots, submit for review"
  lane :release do
    key = asc_api_key

    # 1. Make sure the app exists in App Store Connect (no-op if it already does).
    ensure_app_exists(key)

    # 2. Build a signed, store-ready IPA (Xcode + the API key create the
    #    provisioning profile automatically via -allowProvisioningUpdates).
    build_ipa

    # 3. Upload the build, all metadata and screenshots, then submit for review.
    upload_to_app_store(
      api_key: key,
      app_identifier: APP_ID,
      force: true, # skip the HTML metadata preview/confirm
      run_precheck_before_submit: true,
      submit_for_review: true,
      automatic_release: true,
      submission_information: {
        # App now shows AdMob ads, which use the IDFA (gated by ATT consent).
        add_id_info_uses_idfa: true,
        add_id_info_serves_ads: true,
        add_id_info_tracks_install: false,
        add_id_info_tracks_action: false,
        add_id_info_limits_tracking: true,
        export_compliance_uses_encryption: false,
        content_rights_contains_third_party_content: false,
      },
      metadata_path: "./fastlane/metadata",
      screenshots_path: "./fastlane/screenshots",
    )
  end

  desc "Upload the already-built IPA + metadata + screenshots, wait for processing, submit for review"
  lane :finish do
    key = asc_api_key
    upload_to_app_store(
      api_key: key,
      app_identifier: APP_ID,
      ipa: "build/Exactly67.ipa",
      force: true,
      run_precheck_before_submit: false,
      submit_for_review: true,
      automatic_release: true,
      submission_information: {
        # App now shows AdMob ads, which use the IDFA (gated by ATT consent).
        add_id_info_uses_idfa: true,
        add_id_info_serves_ads: true,
        add_id_info_tracks_install: false,
        add_id_info_tracks_action: false,
        add_id_info_limits_tracking: true,
        export_compliance_uses_encryption: false,
        content_rights_contains_third_party_content: false,
      },
      metadata_path: "./fastlane/metadata",
      screenshots_path: "./fastlane/screenshots",
    )
  end

  desc "Create/stage the 1.2.0 version + push metadata only (no build attach, no submit) — safe, reversible"
  lane :prep_120 do
    key = asc_api_key
    upload_to_app_store(
      api_key: key,
      app_identifier: APP_ID,
      app_version: "1.2.0",
      skip_binary_upload: true,
      skip_screenshots: true,
      submit_for_review: false,
      force: true,
      metadata_path: "./fastlane/metadata",
    )
  end

  desc "Set age rating + attach the processed build + submit for review (text/screenshots already pushed)"
  lane :submit do
    key = asc_api_key
    upload_to_app_store(
      api_key: key,
      app_identifier: APP_ID,
      app_version: "1.2.0",
      build_number: "12",
      skip_binary_upload: true,
      skip_screenshots: true,
      force: true,
      run_precheck_before_submit: true,
      submit_for_review: true,
      # Manual release: the build sits "Pending Developer Release" after approval,
      # so the user presses Release when they want it live.
      automatic_release: false,
      submission_information: {
        # App now shows AdMob ads, which use the IDFA (gated by ATT consent).
        add_id_info_uses_idfa: true,
        add_id_info_serves_ads: true,
        add_id_info_tracks_install: false,
        add_id_info_tracks_action: false,
        add_id_info_limits_tracking: true,
        export_compliance_uses_encryption: false,
        content_rights_contains_third_party_content: false,
      },
      metadata_path: "./fastlane/metadata",
    )
  end

  desc "Upload only the screenshots (metadata/text pushed separately via API)"
  lane :screenshots do
    upload_to_app_store(
      api_key: asc_api_key,
      app_identifier: APP_ID,
      skip_binary_upload: true,
      skip_metadata: true,
      overwrite_screenshots: true,
      force: true,
      submit_for_review: false,
      screenshots_path: "./fastlane/screenshots",
    )
  end

  desc "Upload only metadata + screenshots (no build, no submit) — safe dry-ish run to validate the listing"
  lane :metadata do
    upload_to_app_store(
      api_key: asc_api_key,
      app_identifier: APP_ID,
      skip_binary_upload: true,
      force: true,
      submit_for_review: false,
      metadata_path: "./fastlane/metadata",
      screenshots_path: "./fastlane/screenshots",
    )
  end

  desc "Build + upload the binary to TestFlight (no App Store version, no submit)"
  lane :build_and_upload do
    key = asc_api_key
    build_ipa
    # pilot/TestFlight — does NOT create or verify an App Store version, so it
    # works even when the marketing version (e.g. 1.0.0) already exists on ASC.
    upload_to_testflight(
      api_key: key,
      app_identifier: APP_ID,
      ipa: "build/Exactly67.ipa",
      skip_submission: true,
      skip_waiting_for_build_processing: true,
    )
  end

  desc "Print the latest TestFlight build number ASC knows about (for 1.1.0)"
  lane :tf_latest do
    n = latest_testflight_build_number(
      api_key: asc_api_key,
      app_identifier: APP_ID,
      version: "1.1.0",
    )
    UI.important("LATEST TESTFLIGHT BUILD for 1.1.0 => #{n}")
  end

  desc "Upload the already-built IPA to TestFlight and WAIT for processing (diagnostic)"
  lane :tf_upload_only do
    upload_to_testflight(
      api_key: asc_api_key,
      app_identifier: APP_ID,
      ipa: "build/Exactly67.ipa",
      skip_submission: true,
      skip_waiting_for_build_processing: false,
    )
  end

  desc "Print the App Store version records + their states"
  lane :asc_versions do
    asc_api_key
    require "spaceship"
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    versions = app.get_app_store_versions(limit: 6, includes: "build")
    UI.important("=== App Store versions ===")
    versions.each do |v|
      b = (v.build&.version rescue "-")
      UI.important("version=#{v.version_string}  state=#{v.app_store_state}  build=#{b}")
    end
  end

  desc "List the most recent builds ASC knows about, with processing state"
  lane :tf_builds do
    asc_api_key # sets the Spaceship ConnectAPI token
    require "spaceship"
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    builds = app.get_builds(sort: "-uploadedDate", limit: 6, includes: "preReleaseVersion")
    UI.important("=== recent builds (newest first) ===")
    builds.each do |b|
      mv = (b.pre_release_version&.version rescue "?")
      UI.important("build=#{b.version}  ver=#{mv}  state=#{b.processing_state}  uploaded=#{b.uploaded_date}")
    end
  end
end
